# Copy this file to .env.local for local Vercel development.
# Keep real credentials out of Git.
MONGODB_URI=mongodb+srv://<db-username>:<db-password>@<cluster-host>/?appName=WrenLabs
MONGODB_DB=wrenlabs
GOOGLE_GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail sender account and its Google App Password (not the regular password).
# All inquiry notifications go to wrenlabsph@gmail.com.
GMAIL_USER=wrenlabsph@gmail.com
GMAIL_APP_PASSWORD=
